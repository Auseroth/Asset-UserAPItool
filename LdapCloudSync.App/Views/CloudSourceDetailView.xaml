<UserControl x:Class="LdapCloudSync.App.Views.CloudSourceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LdapCloudSync.Core.Models;assembly=ConNexus.Core">

    <StackPanel>

        <!-- Identity card (shared by both source types) -->
        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Source Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Type badge (read-only, set when source is created) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                    <Border CornerRadius="3" Padding="10,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdSource}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontWeight="Bold" Foreground="White" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Cloud API" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdSource}" Value="True">
                                            <Setter Property="Text" Value="Active Directory" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

       
        <!--  AD SOURCE PANEL                                               -->
        
        <StackPanel Visibility="{Binding IsAdSource, Converter={StaticResource BoolToVis}}">

            <TextBlock Text="Active Directory Connection" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Domain" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdDomain, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Server (optional, overrides domain)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdServer, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdPort, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <CheckBox Content="Use SSL (LDAPS)" IsChecked="{Binding AdUseSsl}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Username (DOMAIN\user or user@domain)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdUsername, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="AdPasswordBox"
                                     PasswordChanged="AdPasswordBox_PasswordChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" />
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Canonical converter -->
            <TextBlock Text="Path Converter" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                        Paste one or more canonical names (one per line) to convert to LDAP format.
                    </TextBlock>
                    <TextBox Text="{Binding CanonicalInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="11"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="50" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="Result:" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ConvertedDn, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" Background="#F0F0F0"
                             TextWrapping="Wrap" Padding="6,4"
                             MinHeight="30" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Use as Computer Search Base"
                                Command="{Binding UseAsComputerSearchBaseCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" Margin="0,0,6,0" />
                        <Button Content="Use as User Search Bases"
                                Command="{Binding UseAsUserSearchBaseCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" Margin="0,0,6,0" />
                        <Button Content="Use as Group Filter"
                                Command="{Binding UseAsUserFilterGroupCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search configuration -->
            <TextBlock Text="Search Configuration" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Computers -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Computer Search Base (OU)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ComputerSearchBase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Computer LDAP Filter" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ComputerFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Preview computers -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Preview Computers" Command="{Binding PreviewComputersCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        <TextBlock Text="{Binding ComputerPreviewStatus}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                            Background="#F8F8F8" CornerRadius="4" Padding="8"
                            Visibility="{Binding ComputerPreviewItems.Count, Converter={StaticResource CountToVis}}">
                        <ListBox ItemsSource="{Binding ComputerPreviewItems}"
                                 MaxHeight="150" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="11" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Users -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="User Search Base (primary OU)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UserSearchBase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="User LDAP Filter" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" MinHeight="40" MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Additional User Search Bases (one per line)"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdditionalUserSearchBases, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="80" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Preview Users" Command="{Binding PreviewUsersCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        <TextBlock Text="{Binding UserPreviewStatus}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                            Background="#F8F8F8" CornerRadius="4" Padding="8"
                            Visibility="{Binding UserPreviewItems.Count, Converter={StaticResource CountToVis}}">
                        <ListBox ItemsSource="{Binding UserPreviewItems}"
                                 MaxHeight="150" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="11" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!--  -->
        <!--  CLOUD SOURCE PANEL                                            -->
        <!--  -->
        <StackPanel Visibility="{Binding IsCloudSource, Converter={StaticResource BoolToVis}}">

            <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Preset Template" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SourcePresetCombo"
                                      ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="Apply"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=SourcePresetCombo}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Auth Type" Style="{StaticResource FieldLabel}" />
                            <ComboBox SelectedValue="{Binding AuthType}"
                                      ItemsSource="{Binding Source={x:Static models:AuthTypeValues.All}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="API Key / Public Key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="API Secret" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Provider Type" Style="{StaticResource FieldLabel}" />
                            <ComboBox SelectedItem="{Binding ProviderType}"
                                      ItemsSource="{Binding Source={x:Static models:ProviderTypeValues.All}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Content Type" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Preset template row -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Assets read config -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Assets (Computers)" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Enabled" IsChecked="{Binding AssetsEnabled}"
                          VerticalAlignment="Center" Margin="16,12,0,0" />
            </StackPanel>
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding AssetsEnabled, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsGetEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g., /api/assets" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsResponsePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip='JSONPath to records array. e.g., $ or $.data' />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Filter (query string, optional)" Style="{StaticResource FieldLabel}"
                                   ToolTip="Appended to the GET URL. Backend support varies by provider." />
                        <TextBox Text="{Binding AssetsFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g., status=active&amp;type=laptop" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Source ID Field" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsSourceIdField, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Field name used as the unique record identifier in this source" />
                    </StackPanel>

                    <!-- Test Retrieve + JSON preview -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Test Retrieve (10)" Command="{Binding TestRetrieveAssetsCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                ToolTip="Fetch 10 records from this source to verify connectivity and field names" />
                        <Button Content="Discover Fields" Command="{Binding DiscoverAssetFieldsCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                Margin="6,0,0,0"
                                ToolTip="Populate the available source field list for use in target mappings" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Last retrieved JSON (assets) -->
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding LastRetrievedAssetsJson.Length, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <TextBlock Text="Last Retrieved - Assets (preview, 10 records)"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding LastRetrievedAssetsJson, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" Background="#F8F8F8"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- Save assets as file source -->
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding AssetsEnabled, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Save as File Source (name)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SaveFileName, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="Leave blank to use the source name." />
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" TextWrapping="Wrap">
                            Fetches ALL records from the source, then saves. Use this to build
                            a static file source for cloud targets.
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Retrieve All &amp; Save"
                            Command="{Binding RetrieveAllAndSaveAssetsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4"
                            ToolTip="Fetches every record (no limit) and writes to ProgramData/ConNexus/sourceFiles/" />
                </Grid>
            </Border>

            <!-- Users read config -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Users" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Enabled" IsChecked="{Binding UsersEnabled}"
                          VerticalAlignment="Center" Margin="16,12,0,0" />
            </StackPanel>
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding UsersEnabled, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Filter (query string, optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Source ID Field" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersSourceIdField, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Test Retrieve (10)" Command="{Binding TestRetrieveUsersCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        <Button Content="Discover Fields" Command="{Binding DiscoverUserFieldsCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Last retrieved JSON (users) -->
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding LastRetrievedUsersJson.Length, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <TextBlock Text="Last Retrieved - Users (preview, 10 records)"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding LastRetrievedUsersJson, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" Background="#F8F8F8"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- Save users as file source -->
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding UsersEnabled, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Save as File Source (name)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SaveFileName, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="Leave blank to use the source name." />
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" TextWrapping="Wrap">
                            Fetches ALL records from the source, then saves. Use this to build
                            a static file source for cloud targets.
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Retrieve All &amp; Save"
                            Command="{Binding RetrieveAllAndSaveUsersCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4"
                            ToolTip="Fetches every record (no limit) and writes to ProgramData/ConNexus/sourceFiles/" />
                </Grid>
            </Border>

        </StackPanel>
    </StackPanel>
</UserControl>