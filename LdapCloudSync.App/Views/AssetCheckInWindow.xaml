<Window x:Class="LdapCloudSync.App.Views.AssetCheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LdapCloudSync.App.ViewModels"
        Title="{Binding WindowTitle}" Width="850" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource SurfaceBrush}"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:AssetCheckInViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="16,12"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Submit an asset turn-in or support request using the Check-in Kiosk."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close (Refresh)"
                            Click="CloseRefresh_Click"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="12"
                            Padding="12,6"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Admin Config"
                            Click="OpenConfiguration_Click"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="12"
                            Padding="12,6"
                            MinHeight="40" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,0">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Request Intake" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" FontSize="25" />

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" FontSize="20">
                                <Run Text="Are you turning in an asset? " />
                                <Run Text="(required)" Foreground="Red" />
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding AssetTurnInOptions}"
                                      SelectedItem="{Binding TurningInAssetAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="20"
                                      MinHeight="52"
                                      Padding="10,8" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasTurnInSelection, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="First Name " />
                                        <Run Text="(required)" Foreground="Red" />
                                    </TextBlock>
                                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MinHeight="52" Padding="12,10" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                          <Run Text="Last Name " />
                                          <Run Text="(required)" Foreground="Red" />
                                    </TextBlock>
                                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MinHeight="52" Padding="12,10" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Phone Number " />
                                    <Run Text="(required)" Foreground="Red" />
                                </TextBlock>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MinHeight="52" Padding="12,10" />
                            </StackPanel>

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding IsTurningInAsset, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Asset Tag" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AssetTag, UpdateSourceTrigger=PropertyChanged}" FontSize="22" MinHeight="56" Padding="12,10" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                        Margin="14,28"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center">
                                    <Run Text="(required)" Foreground="Red" />
                                    <LineBreak />
                                    <Run Text="--or--" />
                                </TextBlock>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SN" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="22" MinHeight="56" Padding="12,10" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Request/Issue Description " />
                                    <Run Text="(required)" Foreground="Red" />
                                </TextBlock>
                                <TextBox Text="{Binding RequestIssueDescription, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="18"
                                         MinHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                                         Padding="12,10"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Panel.ZIndex="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="KeyboardToggleButton"
                                            Grid.Row="0"
                                            Content="On-Screen Keyboard"
                                            Click="ToggleOnScreenKeyboard_Click"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="16"
                                            MinHeight="48"
                                            Padding="16,10"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <Button Content="Submit Request"
                                                Command="{Binding CheckInCommand}"
                                                IsDefault="True"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="20"
                                                MinHeight="56"
                                                Padding="28,12" />
                                        <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="OnScreenKeyboardPanel"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0"
                                        Padding="10"
                                        BorderBrush="#D0D0D0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="#FAFAFA"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                    <Border.LayoutTransform>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Border.LayoutTransform>
                                    <Grid>
                                        <StackPanel x:Name="AlphaKeyboardLayout" HorizontalAlignment="Center">
                                            <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Button Content="Q" Tag="Q" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="W" Tag="W" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="E" Tag="E" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="R" Tag="R" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="T" Tag="T" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="Y" Tag="Y" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="U" Tag="U" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="I" Tag="I" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="O" Tag="O" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="P" Tag="P" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Button Content="A" Tag="A" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="S" Tag="S" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="D" Tag="D" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="F" Tag="F" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="G" Tag="G" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="H" Tag="H" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="J" Tag="J" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="K" Tag="K" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="L" Tag="L" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Button Content="Z" Tag="Z" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="X" Tag="X" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="C" Tag="C" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="V" Tag="V" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="B" Tag="B" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="N" Tag="N" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="M" Tag="M" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="-" Tag="-" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="'" Tag="'" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                            </WrapPanel>

                                            <WrapPanel HorizontalAlignment="Center">
                                                <Button Content="123 / #+=" Click="ToggleSymbolKeyboard_Click" Margin="3" MinWidth="120" MinHeight="54" />
                                                <Button Content="Space" Tag="SPACE" Click="KeyboardKey_Click" Margin="3" MinWidth="220" MinHeight="54" />
                                                <Button Content="Backspace" Tag="BACKSPACE" Click="KeyboardKey_Click" Margin="3" MinWidth="140" MinHeight="54" />
                                                <Button Content="Hide" Click="ToggleOnScreenKeyboard_Click" Margin="3" MinWidth="90" MinHeight="54" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="SymbolKeyboardLayout" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Button Content="1" Tag="1" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="2" Tag="2" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="3" Tag="3" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="4" Tag="4" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="5" Tag="5" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="6" Tag="6" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="7" Tag="7" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="8" Tag="8" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="9" Tag="9" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="0" Tag="0" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Button Content="!" Tag="!" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="@" Tag="@" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="#" Tag="#" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="$" Tag="$" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="%" Tag="%" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="&amp;" Tag="&amp;" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="*" Tag="*" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="(" Tag="(" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content=")" Tag=")" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="?" Tag="?" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Button Content="-" Tag="-" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="_" Tag="_" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="+" Tag="+" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="=" Tag="=" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="/" Tag="/" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content=":" Tag=":" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content=";" Tag=";" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="&quot;" Tag="&quot;" Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="," Tag="," Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                                <Button Content="." Tag="." Click="KeyboardKey_Click" Margin="3" MinWidth="75" MinHeight="54" />
                                            </WrapPanel>

                                            <WrapPanel HorizontalAlignment="Center">
                                                <Button Content="ABC" Click="ToggleSymbolKeyboard_Click" Margin="3" MinWidth="120" MinHeight="54" />
                                                <Button Content="Space" Tag="SPACE" Click="KeyboardKey_Click" Margin="3" MinWidth="220" MinHeight="54" />
                                                <Button Content="Backspace" Tag="BACKSPACE" Click="KeyboardKey_Click" Margin="3" MinWidth="140" MinHeight="54" />
                                                <Button Content="Hide" Click="ToggleOnScreenKeyboard_Click" Margin="3" MinWidth="90" MinHeight="54" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
