<Window x:Class="LdapCloudSync.App.Views.AssetCheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LdapCloudSync.App.ViewModels"
        Title="{Binding WindowTitle}" Width="850" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource SurfaceBrush}"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:AssetCheckInViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="16,12"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Create and submit a check-in payload using the configured sync mappings."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close (Refresh)"
                            Click="CloseRefresh_Click"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="10"
                            Padding="8,3"
                            Margin="0,0,6,0" />
                    <Button Content="Admin Config"
                            Click="OpenConfiguration_Click"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="10"
                            Padding="8,3" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,0">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Scan or Enter Asset" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <TextBlock Text="Enter an asset tag or serial number plus a check-in note. The kiosk writes a Check-in Kiosk source record and immediately sends it to configured cloud targets."
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Asset Tag" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AssetTag, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Padding="10,8" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Padding="10,8" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Check-In Note (required)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CheckInNote, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Check In"
                                    Command="{Binding CheckInCommand}"
                                    IsDefault="True"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,8" />
                            <TextBlock Text="{Binding StatusMessage}" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
