<UserControl x:Class="LdapCloudSync.App.Views.FileSourceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="File Source Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12" />
                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0" TextWrapping="Wrap">
                        Rename here and Save to rename the file on disk.
                        Targets referencing the old name will need to be updated.
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button Content="Save Changes"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,6" FontSize="12" />
                    <TextBlock Text="{Binding SaveStatus}" FontSize="10" Margin="0,4,0,0"
                               Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="JSON Content" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6" TextWrapping="Wrap">
                    Edit the JSON directly. Targets reference this file as "file:[name]".
                    Click Save Changes when done.
                </TextBlock>
                <TextBox Text="{Binding JsonContent, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="11" Background="#F8F8F8"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="300" MaxHeight="600"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>