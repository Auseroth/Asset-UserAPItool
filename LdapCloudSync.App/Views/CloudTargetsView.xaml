<UserControl x:Class="LdapCloudSync.App.Views.CloudTargetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LdapCloudSync.App.Views"
             xmlns:models="clr-namespace:LdapCloudSync.Core.Models;assembly=LdapCloudSync.Core">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Target list -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock Text="Cloud Targets" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="+ Add" Command="{Binding AddTargetCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="- Remove" Command="{Binding RemoveTargetCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Targets}"
                         SelectedItem="{Binding SelectedTarget}"
                         BorderThickness="0" Background="Transparent"
                         Margin="0,4,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0"
                                          ToolTip="Enable this target for sync" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Name}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: Selected target detail (hidden when nothing selected) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedTarget, Converter={StaticResource NullToCollapsed}}">
            <ContentControl Content="{Binding SelectedTarget}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:CloudTargetDetailView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>

        <!-- Placeholder when no target selected -->
        <TextBlock Grid.Column="1"
                   Text="Click '+ Add' to create a cloud target, or select one from the list."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding SelectedTarget, Converter={StaticResource NullToVisible}}" />
    </Grid>
</UserControl>