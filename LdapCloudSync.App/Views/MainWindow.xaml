<Window x:Class="LdapCloudSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LdapCloudSync.App.ViewModels"
        xmlns:views="clr-namespace:LdapCloudSync.App.Views"
        Title="LDAPult - Configuration"
        Width="1100" Height="750" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="16,10"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Service:" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Ellipse VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Refresh" Command="{Binding CheckServiceStatusCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Asset Check-In" Command="{Binding OpenAssetCheckInCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" />
                    <Button Content="Update" Click="OpenUpdateWindow_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" />
                    <Button Content="Test Sync (10)" Command="{Binding TriggerTestSyncCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" />
                    <Button Content="Full Sync" Command="{Binding TriggerSyncCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" />
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,4" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16,12,16,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="Sources">
                <views:SourcesView DataContext="{Binding SourcesVm}" />
            </TabItem>

            <TabItem Header="Cloud Targets">
                <views:CloudTargetsView DataContext="{Binding CloudTargetsVm}" />
            </TabItem>

            <TabItem Header="Logs">
                <views:LogViewerView DataContext="{Binding LogViewerVm}" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="16,6"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
        </Border>
    </Grid>
</Window>
