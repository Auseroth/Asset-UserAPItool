<UserControl x:Class="LdapCloudSync.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LdapCloudSync.App.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: single Border, original working structure restored -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock Text="Sources" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top" />

                <!-- Add / Remove buttons docked to bottom (must come before the fill element) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="+ AD" Command="{Binding AddAdSourceCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11"
                                Margin="0,0,4,0" ToolTip="Add an Active Directory source" />
                        <Button Content="+ Cloud" Command="{Binding AddCloudSourceCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11"
                                Margin="0,0,4,0"
                                ToolTip="Add a cloud API source" />
                        <Button Content="+ File" Command="{Binding AddFileSourceCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11"
                                ToolTip="Browse to an existing JSON file source" />
                    </StackPanel>
                    <Button Content="- Remove" Command="{Binding RemoveSourceCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Fill: source list + file sources section -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Configured sources (AD + Cloud) -->
                        <ListBox ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}"
                                 BorderThickness="0" Background="Transparent"
                                 Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <CheckBox IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"
                                                  ToolTip="Enable this source for sync" />

                                        <!-- Type badge: ONE child only -->
                                        <Border CornerRadius="2" Padding="4,1"
                                                Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdSource}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" FontWeight="Bold" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="CLOUD" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdSource}" Value="True">
                                                                <Setter Property="Text" Value="AD" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Source name OUTSIDE the badge Border -->
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Name}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- File sources section -->
                        <Separator Margin="0,8,0,4" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="File Sources" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <Button Content="&#x21BB;" Command="{Binding RefreshFileSourcesCommand}"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="12" Cursor="Hand" Padding="4,0"
                                    ToolTip="Reload list from disk" />
                        </DockPanel>

                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6">
                            File sources are browsed/linked from existing JSON files.
                            Referenced by targets as "file:name".
                        </TextBlock>

                        <TextBlock Text="No file sources saved yet."
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding FileSourceNames.Count, Converter={StaticResource CountToCollapsed}}"
                                   Margin="0,2,0,0" />

                        <ItemsControl ItemsSource="{Binding FileSourceNames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Background="#E8E8E8" CornerRadius="2"
                                                    Padding="4,1" Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="FILE" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <Button Command="{Binding DataContext.SelectFileSourceCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="0" HorizontalAlignment="Left"
                                                    ToolTip="Click to view or edit this file source">
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           TextDecorations="Underline" />
                                            </Button>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="&#x2715;" FontSize="9" Padding="4,2"
                                                Command="{Binding DataContext.DeleteFileSourceCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Foreground="Gray"
                                                ToolTip="Delete this file source from disk" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right: selected cloud source detail -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedSource, Converter={StaticResource NullToCollapsed}}">
            <ContentControl Content="{Binding SelectedSource}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:CloudSourceDetailView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>

        <!-- Right: selected file source editor -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedFileSource, Converter={StaticResource NullToCollapsed}}">
            <ContentControl Content="{Binding SelectedFileSource}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:FileSourceDetailView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>

        <!-- Placeholder when nothing is selected -->
        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedSource}"     Value="{x:Null}" />
                                <Condition Binding="{Binding SelectedFileSource}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            Select a source from the list, or click a File Source to edit it.
        </TextBlock>
    </Grid>
</UserControl>