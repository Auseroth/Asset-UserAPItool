<UserControl x:Class="LdapCloudSync.App.Views.CloudTargetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LdapCloudSync.Core.Models;assembly=LdapCloudSync.Core">
    <StackPanel>

        <!-- Identity, Source & Preset -->
        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Target Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Preset Template" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                              SelectedItem="{Binding PresetOrigin}"
                              IsEditable="False">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding PresetOrigin}" />
                        </ComboBox.InputBindings>
                    </ComboBox>
                    <Button Content="Apply Template"
                            Command="{Binding ApplyPresetCommand}"
                            CommandParameter="{Binding PresetOrigin}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,2" FontSize="10" Margin="0,4,0,0"
                            ToolTip="Fills in endpoints, mappings, and auth settings from the selected template" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Source Selection -->
        <TextBlock Text="Data Source" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        Source
                        <Run Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                            (configured on the Sources tab  AD, Cloud API, or saved File)
                        </Run>
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding AvailableSourceOptions}"
                              SelectedItem="{Binding SelectedSourceDisplay, Mode=TwoWay}"
                              ToolTip="Which source to pull records from when syncing to this target" />
                </StackPanel>

                <Button Grid.Column="2" Content=" Refresh List"
                        Command="{Binding RefreshSourceOptionsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4"
                        ToolTip="Reload available sources (e.g., after adding a source or saving a file)" />

                <!-- Selected source summary badge -->
                <Border Grid.Column="4" CornerRadius="3" Padding="10,4" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <TextBlock Grid.Column="4"
           Text="{Binding SelectedSourceDisplay}"
           VerticalAlignment="Bottom" Margin="0,0,0,8"
           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
           FontStyle="Italic" />
                </Border>
            </Grid>

            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding IsLinkedFileSourceSelected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="When linked file source sync succeeds" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Success Action" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedValue="{Binding FileSourceSuccessAction}"
                                  ItemsSource="{Binding Source={x:Static models:FileSourceSuccessActionValues.All}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Visibility="{Binding ShowFileSourceRenameSuffix, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Rename Suffix" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FileSourceRenameSuffix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Example: -processed" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            </StackPanel>
        </Border>

        <!-- Connection Settings (Target API) -->
        <TextBlock Text="Target Connection" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Auth Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedValue="{Binding AuthType}"
                                  ItemsSource="{Binding Source={x:Static models:AuthTypeValues.All}}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="API Key / Public Key" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="API Secret" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Provider Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedItem="{Binding ProviderType}"
                                  ItemsSource="{Binding Source={x:Static models:ProviderTypeValues.All}}"
                                  ToolTip="Determines which API client implementation to use" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Content Type" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g., application/json" />
                    </StackPanel>
                </Grid>

                <!-- Asset Panda: Account + Module discovery -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,8,0,0"
                        Visibility="{Binding ShowApSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Asset Panda Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Account" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ApAccounts}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ApAccountId, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshApAccountsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Module" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ApModules}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ApModuleId, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshApModulesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Test Connection" Command="{Binding TestCloudConnectionCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                    <TextBlock Text="{Binding CloudConnectionStatus}" VerticalAlignment="Center"
                               Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Assets Section -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Assets (Computers)" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enabled" IsChecked="{Binding AssetsEnabled}"
                      VerticalAlignment="Center" Margin="16,12,0,0" />
        </StackPanel>
        <Border Style="{StaticResource CardPanel}"
                Visibility="{Binding AssetsEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <!-- Source scope (OU/group selection - relevant for AD sources) -->
                <StackPanel Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                Source Scope
                                <Run Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                                    (OU / Group filter - applies to AD sources only)
                                </Run>
                            </TextBlock>
                            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="3"
                                    MaxHeight="120" Margin="0,2,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <CheckBox Content="Select All" FontWeight="SemiBold" FontSize="11"
                                                  Margin="6,4,0,2"
                                                  Command="{Binding SelectAllAssetsOUsCommand}"
                                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                                        <ItemsControl ItemsSource="{Binding AssetsOUSelections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              Content="{Binding Value}"
                                                              FontFamily="Consolas" FontSize="11"
                                                              Margin="6,1,6,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="2" Content=" Refresh OUs"
                                Command="{Binding RefreshPairedSourceOUsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                ToolTip="Re-discover OUs from the paired AD source" />
                    </Grid>
                    <TextBlock Text="{Binding AssetsEffectiveFilter}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap"
                               ToolTip="The effective source filter that will be applied at sync time" />
                </StackPanel>

                <!-- Reftab Asset Settings -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,4,0,4"
                        Visibility="{Binding ShowCategorySelector, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Reftab Asset Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding AssetCategories}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding AssetsTargetCategoryId, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshCategoriesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Location" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Locations}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedLocationId, Mode=TwoWay}"
                                          IsEditable="False" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshLocationsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Asset Panda Asset Settings -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,4,0,4"
                        Visibility="{Binding ShowApAssetSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Asset Panda Asset Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Collection (Assets)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ApAssetsCollections}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ApAssetsCollectionId, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshApAssetsCollectionsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Load Columns"
                                        Command="{Binding RefreshApAssetColumnsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11"
                                        ToolTip="Fetches column definitions to populate Source Fields" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Generic Endpoints (hidden for AssetPanda) -->
                <Grid Visibility="{Binding HideGenericEndpoints, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="POST Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsPostEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="PUT Endpoint ({id})" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsPutEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Source Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsAdMatchField, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Field from the source record used to match against the cloud record" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cloud Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsCloudMatchField, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Update Match Fields -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Update: Fields to Match" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                                   ToolTip="Pair of fields used to look up existing cloud records for PUT updates." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Source Field" Style="{StaticResource FieldLabel}" />
                                <ComboBox Text="{Binding AssetsUpdateMatchAdField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DiscoveredAdComputerAttributes}"
                                          IsEditable="True" FontSize="11"
                                          ToolTip="Source field to match (e.g., cn, serial_number)" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="=" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6"
                                       FontWeight="Bold" FontSize="14" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cloud Field" Style="{StaticResource FieldLabel}" />
                                <ComboBox Text="{Binding AssetsUpdateMatchCloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DiscoveredAssetCloudFields}"
                                          IsEditable="True" FontSize="11"
                                          ToolTip="Cloud field to compare against (e.g., title, name)" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Asset Field Mappings -->
                <TextBlock Text="Field Mappings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Preview Mappings" Command="{Binding PreviewAssetMappingsCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Fetch one source record and show live values in the Preview column" />
                    <Button Content="Discover Target Fields" Command="{Binding DiscoverAssetFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Discover available field names from the target cloud API" />
                    <Button Content="Discover Source Fields" Command="{Binding DiscoverAdComputerFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Discover available field names from the paired source (AD attributes or API fields)" />
                    <Button Content="+ Add Mapping" Command="{Binding AddAssetMappingCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" />
                </StackPanel>

                <!-- Mapping header row -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Source Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Cloud Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Transform / Default" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="Preview" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding AssetMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Text="{Binding SourceField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAdComputerAttributes, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="->"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2"
                                          Text="{Binding CloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAssetCloudFields, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding TransformExpression, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="4,0,0,0"
                                         ToolTip="{}{field1} {field2} to merge, empty = 1:1 mapping" />
                                <TextBlock Grid.Column="4" Text="{Binding Preview}"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="#4A90D9" VerticalAlignment="Center"
                                           Margin="4,0,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Preview}" />
                                <Button Grid.Column="5" Content="X" FontSize="9" Padding="4,2"
                                        Command="{Binding DataContext.RemoveAssetMappingCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Users Section -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Users (Loanees)" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enabled" IsChecked="{Binding UsersEnabled}"
                      VerticalAlignment="Center" Margin="16,12,0,0" />
        </StackPanel>
        <Border Style="{StaticResource CardPanel}"
                Visibility="{Binding UsersEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <!-- Source scope (Users) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            Source Scope
                            <Run Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                                (OU / Group filter - applies to AD sources only)
                            </Run>
                        </TextBlock>
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="3"
                                MaxHeight="120" Margin="0,2,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <CheckBox Content="Select All" FontWeight="SemiBold" FontSize="11"
                                              Margin="6,4,0,2"
                                              Command="{Binding SelectAllUsersOUsCommand}"
                                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                                    <ItemsControl ItemsSource="{Binding UsersOUSelections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding Value}"
                                                          FontFamily="Consolas" FontSize="11"
                                                          Margin="6,1,6,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding UsersEffectiveFilter}" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,0">
                        <CheckBox Content="Group (memberOf)" IsChecked="{Binding UsersAdSourceIsGroup}"
                                  FontSize="11"
                                  ToolTip="Treat selections as group DNs and filter by memberOf instead of OU search" />
                    </StackPanel>

                    <Button Grid.Column="4" Content="Refresh OUs"
                            Command="{Binding RefreshPairedSourceOUsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,4" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,0"
                            ToolTip="Re-discover OUs from the paired AD source" />
                </Grid>

                <!-- Asset Panda People Settings -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,4,0,4"
                        Visibility="{Binding ShowApUserSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Asset Panda People Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Collection (People)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ApUsersCollections}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ApUsersCollectionId, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshApUsersCollectionsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Load Columns"
                                        Command="{Binding RefreshApUserColumnsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11"
                                        ToolTip="Fetches column definitions to populate Source Fields" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Generic Endpoints (hidden for AssetPanda) -->
                <Grid Visibility="{Binding HideGenericEndpoints, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="POST Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersPostEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="PUT Endpoint ({id})" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersPutEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Source Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersAdMatchField, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Field from the source record used to match against the cloud record" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cloud Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersCloudMatchField, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Update Match Fields -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Update: Fields to Match" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                                   ToolTip="Pair of fields used to look up existing cloud records for PUT updates." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Source Field" Style="{StaticResource FieldLabel}" />
                                <ComboBox Text="{Binding UsersUpdateMatchAdField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DiscoveredAdUserAttributes}"
                                          IsEditable="True" FontSize="11"
                                          ToolTip="Source field to match (e.g., mail, sAMAccountName)" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="=" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6"
                                       FontWeight="Bold" FontSize="14" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cloud Field" Style="{StaticResource FieldLabel}" />
                                <ComboBox Text="{Binding UsersUpdateMatchCloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DiscoveredUserCloudFields}"
                                          IsEditable="True" FontSize="11"
                                          ToolTip="Cloud field to compare against (e.g., email, name)" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- User Field Mappings -->
                <TextBlock Text="Field Mappings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Preview Mappings" Command="{Binding PreviewUserMappingsCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Fetch one source record and show live values in the Preview column" />
                    <Button Content="Discover Target Fields" Command="{Binding DiscoverUserFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Discover available field names from the target cloud API" />
                    <Button Content="Discover Source Fields" Command="{Binding DiscoverAdUserFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Discover available field names from the paired source (AD attributes or API fields)" />
                    <Button Content="+ Add Mapping" Command="{Binding AddUserMappingCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" />
                </StackPanel>

                <!-- Mapping header row -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Source Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Cloud Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Transform / Default" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="Preview" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding UserMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Text="{Binding SourceField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAdUserAttributes, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="->"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2"
                                          Text="{Binding CloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredUserCloudFields, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding TransformExpression, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="4,0,0,0"
                                         ToolTip="{}{field1} {field2} to merge, empty = 1:1 mapping" />
                                <TextBlock Grid.Column="4" Text="{Binding Preview}"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="#4A90D9" VerticalAlignment="Center"
                                           Margin="4,0,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Preview}" />
                                <Button Grid.Column="5" Content="X" FontSize="9" Padding="4,2"
                                        Command="{Binding DataContext.RemoveUserMappingCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Schedule Section -->
        <TextBlock Text="Schedule" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <CheckBox Content="Coupled schedule (Assets and Users share the same schedule)"
                          IsChecked="{Binding CoupledSchedule}" Margin="0,0,0,8" />

                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Shared Schedule" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoupledSchedule}" Value="False">
                                    <Setter Property="Text" Value="Assets Schedule" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Every X hours" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Interval}"
                                 Margin="0,0,16,0" />
                    <RadioButton Content="Daily at specific time" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DailyAt}"
                                 Margin="0,0,16,0" />
                    <RadioButton Content="Advanced (Cron)" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Cron}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PrimaryScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Interval}">
                    <TextBlock Text="Run every" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding PrimaryIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" VerticalAlignment="Center" />
                    <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PrimaryScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=DailyAt}">
                    <TextBlock Text="Run daily at" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding PrimaryDailyAtTimeText, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" VerticalAlignment="Center" />
                    <TextBlock Text="(24hr format)" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </StackPanel>

                <StackPanel
                    Visibility="{Binding PrimaryScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Cron}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cron expression" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PrimaryCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" VerticalAlignment="Center" FontFamily="Consolas" />
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap">
                        Format: min hour day month weekday | Examples: '0 2 * * *' = daily 2am | '0 */6 * * *' = every 6 hours
                    </TextBlock>
                </StackPanel>

                <!-- Users schedule (only shown when not coupled) -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding CoupledSchedule, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Users Schedule" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Every X hours"
                                     IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Interval}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Daily at specific time"
                                     IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DailyAt}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Advanced (Cron)"
                                     IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Cron}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding UsersScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Interval}">
                        <TextBlock Text="Run every" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UsersIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center" />
                        <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding UsersScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=DailyAt}">
                        <TextBlock Text="Run daily at" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UsersDailyAtTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="(24hr format)" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <StackPanel
                        Visibility="{Binding UsersScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Cron}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cron expression" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding UsersCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" VerticalAlignment="Center" FontFamily="Consolas" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Test Sync -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Test Sync (10 records)" Command="{Binding RunLocalTestSyncCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="12" />
                <TextBlock Text="Fetches 10 source records, transforms them, and shows the exact API payload before sending."
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>