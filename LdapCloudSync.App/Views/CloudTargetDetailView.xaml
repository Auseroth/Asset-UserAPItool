<UserControl x:Class="LdapCloudSync.App.Views.CloudTargetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LdapCloudSync.Core.Models;assembly=LdapCloudSync.Core">

    <StackPanel>

        <!-- Identity & Preset -->
        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Target Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Preset Template" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                              SelectedItem="{Binding PresetOrigin}"
                              IsEditable="False" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection Settings -->
        <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Auth Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedValue="{Binding AuthType}"
                                  ItemsSource="{Binding Source={x:Static models:AuthTypeValues.All}}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="API Key / Public Key" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="API Secret" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Test Connection" Command="{Binding TestCloudConnectionCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                    <TextBlock Text="{Binding CloudConnectionStatus}" VerticalAlignment="Center"
                               Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Assets Section -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Assets (Computers)" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enabled" IsChecked="{Binding AssetsEnabled}" VerticalAlignment="Center" Margin="16,12,0,0" />
        </StackPanel>
        <Border Style="{StaticResource CardPanel}" Visibility="{Binding AssetsEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="POST Endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsPostEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="PUT Endpoint ({id})" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsPutEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AD Match Field" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsAdMatchField, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Cloud Match Field" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AssetsCloudMatchField, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Asset Field Mapping -->
                <TextBlock Text="Field Mappings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Discover Cloud Fields" Command="{Binding DiscoverAssetFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="Discover AD Attributes" Command="{Binding DiscoverAdComputerFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="+ Add Mapping" Command="{Binding AddAssetMappingCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11" />
                </StackPanel>

                <!-- Mapping grid header -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AD Attribute" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Cloud Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Transform / Default" FontWeight="SemiBold" FontSize="11" />
                </Grid>

                <ItemsControl ItemsSource="{Binding AssetMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Text="{Binding AdAttribute, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAdComputerAttributes, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" Text="{Binding CloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAssetCloudFields, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBox Grid.Column="3" Text="{Binding TransformExpression, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="4,0,0,0"
                                         ToolTip="Optional: {attr1} {attr2} for merge, or leave empty for 1:1 mapping" />
                                <Button Grid.Column="4" Content="X" FontSize="9" Padding="4,2"
                                        Command="{Binding DataContext.RemoveAssetMappingCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Users Section -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Users (Loanees)" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enabled" IsChecked="{Binding UsersEnabled}" VerticalAlignment="Center" Margin="16,12,0,0" />
        </StackPanel>
        <Border Style="{StaticResource CardPanel}" Visibility="{Binding UsersEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="POST Endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersPostEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="PUT Endpoint ({id})" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersPutEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AD Match Field" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersAdMatchField, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Cloud Match Field" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UsersCloudMatchField, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- User Field Mapping -->
                <TextBlock Text="Field Mappings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Discover Cloud Fields" Command="{Binding DiscoverUserFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="Discover AD Attributes" Command="{Binding DiscoverAdUserFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="+ Add Mapping" Command="{Binding AddUserMappingCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11" />
                </StackPanel>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AD Attribute" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Cloud Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Transform / Default" FontWeight="SemiBold" FontSize="11" />
                </Grid>

                <ItemsControl ItemsSource="{Binding UserMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Text="{Binding AdAttribute, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAdUserAttributes, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" Text="{Binding CloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredUserCloudFields, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBox Grid.Column="3" Text="{Binding TransformExpression, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="4,0,0,0"
                                         ToolTip="Optional: {attr1} {attr2} for merge, or leave empty for 1:1 mapping" />
                                <Button Grid.Column="4" Content="X" FontSize="9" Padding="4,2"
                                        Command="{Binding DataContext.RemoveUserMappingCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Schedule Section -->
        <TextBlock Text="Schedule" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <CheckBox Content="Coupled schedule (Assets and Users share the same schedule)"
                          IsChecked="{Binding CoupledSchedule}" Margin="0,0,0,8" />

                <!-- Primary / Assets Schedule -->
                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Shared Schedule" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoupledSchedule}" Value="False">
                                    <Setter Property="Text" Value="Assets Schedule" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Interval" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Interval}"
                                 Margin="0,0,16,0" />
                    <RadioButton Content="Daily At" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DailyAt}"
                                 Margin="0,0,16,0" />
                    <RadioButton Content="Cron" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Cron}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding PrimaryIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" VerticalAlignment="Center" />
                    <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,20,0" />
                    <TextBlock Text="Cron:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding PrimaryCronExpression, UpdateSourceTrigger=PropertyChanged}"
                             Width="150" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Users Schedule (only when decoupled) -->
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoupledSchedule}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Users Schedule" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Interval" IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Interval}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Daily At" IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DailyAt}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Cron" IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Cron}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UsersIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center" />
                        <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,20,0" />
                        <TextBlock Text="Cron:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UsersCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>