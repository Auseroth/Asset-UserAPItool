<UserControl x:Class="LdapCloudSync.App.Views.CloudTargetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LdapCloudSync.Core.Models;assembly=LdapCloudSync.Core">
    <StackPanel>

        <!-- Identity & Preset -->
        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Target Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Preset Template" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                              SelectedItem="{Binding PresetOrigin}"
                              IsEditable="False">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding PresetOrigin}" />
                        </ComboBox.InputBindings>
                    </ComboBox>
                    <Button Content="Apply Template" 
                            Command="{Binding ApplyPresetCommand}" 
                            CommandParameter="{Binding PresetOrigin}"
                            Style="{StaticResource SecondaryButton}" 
                            Padding="8,2" FontSize="10" Margin="0,4,0,0"
                            ToolTip="Fills in endpoints, mappings, and auth settings from the selected template" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection Settings -->
        <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Auth Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedValue="{Binding AuthType}"
                                  ItemsSource="{Binding Source={x:Static models:AuthTypeValues.All}}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="API Key / Public Key" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="API Secret" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Provider Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedItem="{Binding ProviderType}"
                                  ItemsSource="{Binding Source={x:Static models:ProviderTypeValues.All}}"
                                  ToolTip="Determines which API client implementation to use" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Content Type" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="e.g., application/json" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Test Connection" Command="{Binding TestCloudConnectionCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                    <TextBlock Text="{Binding CloudConnectionStatus}" VerticalAlignment="Center"
                               Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Assets Section -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Assets (Computers)" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enabled" IsChecked="{Binding AssetsEnabled}" VerticalAlignment="Center" Margin="16,12,0,0" />
        </StackPanel>
        <Border Style="{StaticResource CardPanel}" Visibility="{Binding AssetsEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- AD Source for Assets -->
                <StackPanel Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AD Source (Computer OUs)" Style="{StaticResource FieldLabel}" />
                            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" MaxHeight="120" Margin="0,2,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <CheckBox Content="Select All" FontWeight="SemiBold" FontSize="11" Margin="6,4,0,2"
                                                  Command="{Binding SelectAllAssetsOUsCommand}"
                                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                                        <ItemsControl ItemsSource="{Binding AssetsOUSelections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Value}"
                                                              FontFamily="Consolas" FontSize="11" Margin="6,1,6,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="2" Content="&#x21BB; Refresh OUs"
                                Command="{Binding DataContext.AdSettingsVm.RefreshOUsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                ToolTip="Re-discover OUs from Active Directory (use after changing AD settings)" />
                    </Grid>
                    <TextBlock Text="{Binding AssetsEffectiveFilter}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"
                               ToolTip="The LDAP filter that will be used at sync time" />
                </StackPanel>

                <!-- Reftab Asset Settings (Category + Location) - only visible for Reftab -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,4,0,4"
                        Visibility="{Binding ShowCategorySelector, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Reftab Asset Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding AssetCategories}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding AssetsTargetCategoryId, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshCategoriesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Location" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Locations}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedLocationId, Mode=TwoWay}"
                                          IsEditable="False" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshLocationsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Asset Panda Asset Settings (Collection + Columns) - only visible for AssetPanda -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,4,0,4"
                        Visibility="{Binding ShowApAssetSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Asset Panda Asset Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Collection (Assets)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ApAssetsCollections}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ApAssetsCollectionId, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshApAssetsCollectionsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Load Columns"
                                        Command="{Binding RefreshApAssetColumnsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11"
                                        ToolTip="Fetches column definitions from the selected collection to populate Cloud Fields" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Generic Endpoints (hidden for Asset Panda) -->
                <Grid Visibility="{Binding HideGenericEndpoints, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="POST Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsPostEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="PUT Endpoint ({id})" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsPutEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AD Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsAdMatchField, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cloud Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AssetsCloudMatchField, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Asset Field Mapping -->
                <TextBlock Text="Field Mappings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="&#x25B6; Preview Mappings" Command="{Binding PreviewAssetMappingsCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Queries AD for the first computer record and shows real values in the Preview column" />
                    <Button Content="Discover Cloud Fields" Command="{Binding DiscoverAssetFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="Discover AD Attributes" Command="{Binding DiscoverAdComputerFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="+ Add Mapping" Command="{Binding AddAssetMappingCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" />
                </StackPanel>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AD Attribute" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Cloud Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Transform / Default" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="Preview" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding AssetMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Text="{Binding AdAttribute, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAdComputerAttributes, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" Text="{Binding CloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAssetCloudFields, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBox Grid.Column="3" Text="{Binding TransformExpression, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="4,0,0,0"
                                         ToolTip="Optional: {attr1} {attr2} for merge, or leave empty for 1:1 mapping" />
                                <TextBlock Grid.Column="4" Text="{Binding Preview}" FontFamily="Consolas" FontSize="10"
                                           Foreground="#4A90D9" VerticalAlignment="Center" Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Preview}" />
                                <Button Grid.Column="5" Content="X" FontSize="9" Padding="4,2"
                                        Command="{Binding DataContext.RemoveAssetMappingCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Users Section -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Users (Loanees)" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enabled" IsChecked="{Binding UsersEnabled}" VerticalAlignment="Center" Margin="16,12,0,0" />
        </StackPanel>
        <Border Style="{StaticResource CardPanel}" Visibility="{Binding UsersEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- AD Source for Users -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AD Source (User OUs or Groups)" Style="{StaticResource FieldLabel}" />
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" MaxHeight="120" Margin="0,2,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <CheckBox Content="Select All" FontWeight="SemiBold" FontSize="11" Margin="6,4,0,2"
                                              Command="{Binding SelectAllUsersOUsCommand}"
                                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                                    <ItemsControl ItemsSource="{Binding UsersOUSelections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Value}"
                                                          FontFamily="Consolas" FontSize="11" Margin="6,1,6,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding UsersEffectiveFilter}" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   ToolTip="The LDAP filter that will be used at sync time" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,0">
                        <CheckBox Content="Group (memberOf)" IsChecked="{Binding UsersAdSourceIsGroup}"
                                  ToolTip="Check to treat selections as group DNs and filter by memberOf instead of searching OUs directly."
                                  FontSize="11" />
                    </StackPanel>

                    <Button Grid.Column="4" Content="&#x21BB; Refresh OUs"
                            Command="{Binding DataContext.AdSettingsVm.RefreshOUsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,4" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,0"
                            ToolTip="Re-discover OUs from Active Directory (use after changing AD settings)" />
                </Grid>

                <!-- Asset Panda People Settings (Collection + Columns) - only visible for AssetPanda -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,4,0,4"
                        Visibility="{Binding ShowApUserSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Asset Panda People Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Collection (People)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ApUsersCollections}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ApUsersCollectionId, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshApUsersCollectionsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Load Columns"
                                        Command="{Binding RefreshApUserColumnsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11"
                                        ToolTip="Fetches column definitions from the selected collection to populate Cloud Fields" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Generic Endpoints (hidden for Asset Panda) -->
                <Grid Visibility="{Binding HideGenericEndpoints, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GET Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersGetEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="POST Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersPostEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="PUT Endpoint ({id})" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersPutEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Response Items Path" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersResponsePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AD Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersAdMatchField, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cloud Match Field" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UsersCloudMatchField, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- User Field Mapping -->
                <TextBlock Text="Field Mappings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="&#x25B6; Preview Mappings" Command="{Binding PreviewUserMappingsCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                            ToolTip="Queries AD for the first user record and shows real values in the Preview column" />
                    <Button Content="Discover Cloud Fields" Command="{Binding DiscoverUserFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="Discover AD Attributes" Command="{Binding DiscoverAdUserFieldsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="+ Add Mapping" Command="{Binding AddUserMappingCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" />
                </StackPanel>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AD Attribute" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Cloud Field" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Transform / Default" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="Preview" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding UserMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Text="{Binding AdAttribute, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredAdUserAttributes, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="->" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" Text="{Binding CloudField, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.DiscoveredUserCloudFields, RelativeSource={RelativeSource AncestorType=Border}}"
                                          IsEditable="True" FontSize="11" />
                                <TextBox Grid.Column="3" Text="{Binding TransformExpression, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="4,0,0,0"
                                         ToolTip="Optional: {attr1} {attr2} for merge, or leave empty for 1:1 mapping" />
                                <TextBlock Grid.Column="4" Text="{Binding Preview}" FontFamily="Consolas" FontSize="10"
                                           Foreground="#4A90D9" VerticalAlignment="Center" Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Preview}" />
                                <Button Grid.Column="5" Content="X" FontSize="9" Padding="4,2"
                                        Command="{Binding DataContext.RemoveUserMappingCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>


        <!-- Schedule Section -->
        <TextBlock Text="Schedule" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <CheckBox Content="Coupled schedule (Assets and Users share the same schedule)"
                          IsChecked="{Binding CoupledSchedule}" Margin="0,0,0,8" />

                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Shared Schedule" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoupledSchedule}" Value="False">
                                    <Setter Property="Text" Value="Assets Schedule" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Every X hours" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Interval}"
                                 Margin="0,0,16,0" />
                    <RadioButton Content="Daily at specific time" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DailyAt}"
                                 Margin="0,0,16,0" />
                    <RadioButton Content="Advanced (Cron)" IsChecked="{Binding PrimaryScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Cron}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PrimaryScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Interval}">
                    <TextBlock Text="Run every" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding PrimaryIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" VerticalAlignment="Center" />
                    <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PrimaryScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=DailyAt}">
                    <TextBlock Text="Run daily at" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding PrimaryDailyAtTimeText, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" VerticalAlignment="Center" />
                    <TextBlock Text="(24hr format)" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </StackPanel>

                <StackPanel Visibility="{Binding PrimaryScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Cron}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cron expression" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PrimaryCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" VerticalAlignment="Center" FontFamily="Consolas" />
                    </StackPanel>
                    <TextBlock Text="Format: min hour day month weekday | Examples: '0 2 * * *' = daily 2am | '0 */6 * * *' = every 6 hours"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoupledSchedule}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Users Schedule" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Every X hours" IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Interval}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Daily at specific time" IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DailyAt}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Advanced (Cron)" IsChecked="{Binding UsersScheduleType, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Cron}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding UsersScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Interval}">
                        <TextBlock Text="Run every" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UsersIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center" />
                        <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding UsersScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=DailyAt}">
                        <TextBlock Text="Run daily at" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UsersDailyAtTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="(24hr format)" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding UsersScheduleType, Converter={StaticResource EnumToVis}, ConverterParameter=Cron}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cron expression" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding UsersCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" VerticalAlignment="Center" FontFamily="Consolas" />
                        </StackPanel>
                        <TextBlock Text="Format: min hour day month weekday | Examples: '0 2 * * *' = daily 2am | '0 3 * * 1-5' = weekdays 3am"
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>