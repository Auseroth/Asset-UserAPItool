<UserControl x:Class="LdapCloudSync.App.Views.AdSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="900">

            <TextBlock Text="Active Directory Connection" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Domain" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Server (optional, overrides domain)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <CheckBox Content="Use SSL (LDAPS)" IsChecked="{Binding UseSsl}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Username (DOMAIN\user or user@domain)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" />
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Canonical Name Converter -->
            <TextBlock Text="Path Converter" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                        Paste one or more canonical names (one per line) to convert to LDAP format.
                        For group filters, multiple groups are combined with OR logic.
                        For search bases, multiple paths are queried separately and deduplicated.
                    </TextBlock>

                    <TextBox Text="{Binding CanonicalInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="11"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="50" MaxHeight="100"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="One per line, e.g.&#x0a;Domain/OU/OU/OU or CN" />

                    <!-- Output -->
                    <TextBlock Text="Result:" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ConvertedDn, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" Background="#F0F0F0"
                             TextWrapping="Wrap" Padding="6,4"
                             MinHeight="30" MaxHeight="100"
                             VerticalScrollBarVisibility="Auto" />

                    <!-- Quick-use buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Use as Computer Search Base"
                                Command="{Binding UseAsComputerSearchBaseCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" Margin="0,0,6,0" />
                        <Button Content="Use as User Search Bases"
                                Command="{Binding UseAsUserSearchBaseCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" Margin="0,0,6,0" />
                        <Button Content="Use as Group Filter (memberOf)"
                                Command="{Binding UseAsUserFilterGroupCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Search Configuration" Style="{StaticResource SectionHeader}" />

            <!-- Computers -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Computer Search Base (OU)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ComputerSearchBase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Computer LDAP Filter" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ComputerFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Preview Computers" Command="{Binding PreviewComputersCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        <TextBlock Text="{Binding ComputerPreviewStatus}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                            Background="#F8F8F8" CornerRadius="4" Padding="8"
                            Visibility="{Binding ComputerPreviewItems.Count, Converter={StaticResource CountToVis}}">
                        <ListBox ItemsSource="{Binding ComputerPreviewItems}"
                                 MaxHeight="180" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="11" />
                    </Border>
                </Grid>
            </Border>

            <!-- Users -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="User Search Base (primary OU)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UserSearchBase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="User LDAP Filter" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" MinHeight="40" MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Additional search bases -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Additional User Search Bases (one per line, queried separately and deduplicated)"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdditionalUserSearchBases, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                               Margin="0,6,0,0" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        Tip: Use the Path Converter to paste multiple OU paths or group names.
                        "Use as User Search Bases" splits them across the primary and additional fields.
                        "Use as Group Filter" combines them with OR logic in the filter.
                    </TextBlock>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Preview Users" Command="{Binding PreviewUsersCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        <TextBlock Text="{Binding UserPreviewStatus}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                            Background="#F8F8F8" CornerRadius="4" Padding="8"
                            Visibility="{Binding UserPreviewItems.Count, Converter={StaticResource CountToVis}}">
                        <ListBox ItemsSource="{Binding UserPreviewItems}"
                                 MaxHeight="180" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="11" />
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>