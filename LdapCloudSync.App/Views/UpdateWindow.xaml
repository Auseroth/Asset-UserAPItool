<Window x:Class="LdapCloudSync.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Connexus"
        Width="760"
        Height="420"
        MinWidth="680"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="16,12"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Application Update" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Check GitHub releases and download the latest installer executable."
                           Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Release URL" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ReleaseUrlTextBox" FontSize="13" Padding="10,8" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current Version" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="CurrentVersionTextBlock" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Latest Version" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="LatestVersionTextBlock" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="0,14,0,2" />
                <TextBlock x:Name="StatusTextBlock"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MinHeight="48" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CheckUpdatesButton"
                            Content="Check for Updates"
                            Click="CheckForUpdates_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,6"
                            MinWidth="160"
                            Margin="0,0,8,0"
                            Visibility="Visible" />
                    <Button x:Name="DownloadAndRunButton"
                            Content="Update Now"
                            Click="DownloadAndRun_Click"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,6"
                            MinWidth="190"
                            Visibility="Visible"
                            IsEnabled="True" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Update Now"
                    Click="DownloadAndRun_Click"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    MinWidth="160" />
            <Button Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
