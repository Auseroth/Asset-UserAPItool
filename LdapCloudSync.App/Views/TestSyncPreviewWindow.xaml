<Window x:Class="LdapCloudSync.App.Views.TestSyncPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Sync Preview" Width="750" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="16,12"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Testing sync with the following structure:" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Payload display -->
        <Border Grid.Row="1" Margin="16,8,16,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Captures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8F8F8" CornerRadius="4" Padding="12" Margin="0,0,0,8"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6">
                                        <Run Text="{Binding Method}" Foreground="#D9534F" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Endpoint}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBox Text="{Binding PrettyJson, Mode=OneWay}" 
                                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action buttons -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="16,10"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}" Padding="20,6" FontSize="12" Margin="0,0,8,0" />
                <Button Content="Proceed with Sync" Click="Proceed_Click"
                        Style="{StaticResource PrimaryButton}" Padding="20,6" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>